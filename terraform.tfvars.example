# Copy this to terraform.tfvars (it's gitignored). The defaults in variables.tf
# are the names from my own proof of concept. Swap yourname for your short name
# in the resource group name, and set the owner tag to your name too.

resource_group_name = "rg-tf-poc-yourname01"

tags = {
  project     = "azure-terraform-iac-poc"
  environment = "poc"
  managed-by  = "terraform"
  owner       = "yourname"
}
